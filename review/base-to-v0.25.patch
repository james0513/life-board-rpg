+      _player.life.homeLevel * 3;
+
+  String _money(int value) => '\$$value';
+
+  String get _homeTitle => switch (_player.life.homeLevel) {
+    0 => '尚未置產',
+    1 => '溫馨小屋',
+    _ => '舒適宅邸',
+  };
+
+  Future<void> _act(String action, String title) async {
+    if (_busy || _confirming) return;
+    setState(() {
+      _busy = true;
+      _error = null;
+      _notice = null;
+    });
