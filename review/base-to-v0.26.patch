+                  fontWeight: FontWeight.w600,
+                ),
+              ),
+              const SizedBox(height: 8),
+              for (final chapter in chain.chapters) _chapterProgress(chapter),
+              if ((_player.story.storySteps[chain.id] ?? 0) >=
