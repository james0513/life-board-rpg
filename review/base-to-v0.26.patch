+    );
+    _base!.draw(canvas, size, camera);
+    final p = worldFromPoint(pawn.position.x, pawn.position.y + 1);
+    Models3D.hero(
+      actor,
+      p + const V3(0, .16, 0),
+      _equipment,
+      scale: .58,
+      walk: pawn.isWalking ? _clock * 12 : 0,
+      facing: _heading,
+    );
+    scene.drawWithForeground(
+      canvas,
+      size,
+      camera,
+      actor,
+      labels: () {
+        for (final tile in board.tiles) {
+          final point = centers[tile.index],
+              p = worldFromPoint(point.x, point.y) + const V3(0, .13, .3);
+          final projected = camera.project(p, size);
+          if (projected == null) continue;
+          final text = TextPainter(
+            text: TextSpan(
+              text:
+                  '${tile.index + 1}  ${TileComponent.labels[tile.kind.index]}',
+              style: const TextStyle(
+                fontSize: 9,
+                fontWeight: FontWeight.w600,
+                color: Color(0xFFFFF4DB),
+              ),
+            ),
+            textDirection: TextDirection.ltr,
+          )..layout();
+          final plate = RRect.fromRectAndRadius(
+            Rect.fromCenter(
+              center: projected + const Offset(0, 6),
+              width: text.width + 10,
+              height: 17,
+            ),
+            const Radius.circular(5),
+          );
+          canvas.drawRRect(plate, Paint()..color = const Color(0xEB303B40));
+          canvas.drawRRect(
+            plate,
+            Paint()
+              ..color = ChapterPalette.forStage(board.visualStage).metal
+              ..style = PaintingStyle.stroke
+              ..strokeWidth = .7,
+          );
+          text.paint(
+            canvas,
+            Offset(
+              projected.dx - text.width / 2,
+              projected.dy + 6 - text.height / 2,
+            ),
+          );
+          text.dispose();
+        }
+        final feet = camera.project(p + const V3(0, .14, 0), size);
+        if (feet != null) {
+          canvas.drawOval(
+            Rect.fromCenter(center: feet, width: 32, height: 12),
+            Paint()..color = const Color(0x66403824),
+          );
+          canvas.drawOval(
+            Rect.fromCenter(center: feet, width: 38, height: 16),
+            Paint()
+              ..color = const Color(0xFFFFE8A8)
+              ..style = PaintingStyle.stroke
+              ..strokeWidth = 2,
+          );
+        }
+      },
+    );
+    canvas.restore();
+  }
+
+  Future<bool> move({
+    required int from,
+    required int steps,
+    required void Function(int) onPosition,
+  }) {
+    if (!isBoardReady) return Future.value(false);
+    final indices = List.generate(steps, (i) => nextPosition(from, i + 1));
+    return pawn.walk(
+      indices.map(pawnCenter).toList(),
+      (step) => onPosition(indices[step]),
+    );
+  }
 }
