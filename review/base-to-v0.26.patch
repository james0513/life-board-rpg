+        const Text(
+          '通關全部六章，或年滿 60 歲，就能轉生。\n挑選一項已學會的職業心得，將它的屬性加成帶進新的人生。',
+          style: TextStyle(color: _muted, height: 1.7),
+        ),
+        const SizedBox(height: 16),
+        FilledButton.icon(
