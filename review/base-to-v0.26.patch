diff --git a/lib/domain/models/life_progress.dart b/lib/domain/models/life_progress.dart
new file mode 100644
index 0000000..6acc585
--- /dev/null
+++ b/lib/domain/models/life_progress.dart
@@ -0,0 +1,179 @@
+import 'json_checks.dart';
+
+/// Original life-simulation rules: four turns are one year, starting at 18.
+///
+/// The const constructor creates a fresh life with immutable empty collections.
+/// Use [copyWith] to add practice or skills; it defensively copies both inputs.
+class LifeProgress {
+  static const int maxCounter = 1000000;
+
+  final int turns;
+  final int generation;
+  final int eq;
+  final int stress;
+  final int affection;
+  final int homeLevel;
+  final Map<String, int> jobPractice;
+  final List<String> learnedSkills;
+  final String? inheritedSkill;
+
+  const LifeProgress({
+    this.turns = 0,
+    this.generation = 1,
+    this.eq = 50,
+    this.stress = 0,
+    this.affection = 0,
+    this.homeLevel = 0,
+  }) : jobPractice = const {},
+       learnedSkills = const [],
+       inheritedSkill = null,
+       assert(turns >= 0 && turns <= maxCounter),
+       assert(generation >= 1 && generation <= maxCounter),
+       assert(eq >= 0 && eq <= 100),
+       assert(stress >= 0 && stress <= 100),
+       assert(affection >= 0 && affection <= 100),
+       assert(homeLevel >= 0 && homeLevel <= 2);
+
+  const LifeProgress._({
+    required this.turns,
+    required this.generation,
+    required this.eq,
+    required this.stress,
+    required this.affection,
+    required this.homeLevel,
+    required this.jobPractice,
+    required this.learnedSkills,
+    required this.inheritedSkill,
+  });
+
+  int get age => 18 + turns ~/ 4;
+  int get seasonIndex => turns % 4;
+  String get season => const ['春', '夏', '秋', '冬'][seasonIndex];
+
+  LifeProgress copyWith({
+    int? turns,
+    int? generation,
+    int? eq,
+    int? stress,
+    int? affection,
+    int? homeLevel,
+    Map<String, int>? jobPractice,
+    List<String>? learnedSkills,
+    String? inheritedSkill,
+    bool clearInheritedSkill = false,
+  }) {
+    final next = LifeProgress._(
+      turns: turns ?? this.turns,
+      generation: generation ?? this.generation,
+      eq: eq ?? this.eq,
+      stress: stress ?? this.stress,
+      affection: affection ?? this.affection,
+      homeLevel: homeLevel ?? this.homeLevel,
+      jobPractice: jobPractice == null
+          ? this.jobPractice
+          : Map<String, int>.unmodifiable(jobPractice),
+      learnedSkills: learnedSkills == null
+          ? this.learnedSkills
+          : List<String>.unmodifiable(learnedSkills),
+      inheritedSkill: clearInheritedSkill
+          ? null
+          : inheritedSkill ?? this.inheritedSkill,
+    );
+    next._validate();
+    return next;
+  }
+
+  void _validate({Set<String>? validJobIds}) {
+    void inRange(int value, int minimum, int maximum, String name) {
+      if (value < minimum || value > maximum) {
+        throw FormatException('life.$name 超出有效範圍');
+      }
+    }
+
+    void checkJob(String id) {
+      if (id.trim().isEmpty ||
+          (validJobIds != null && !validJobIds.contains(id))) {
+        throw const FormatException('人生技能或熟練度的職業不存在');
+      }
+    }
+
+    inRange(turns, 0, maxCounter, 'turns');
+    inRange(generation, 1, maxCounter, 'generation');
+    inRange(eq, 0, 100, 'eq');
+    inRange(stress, 0, 100, 'stress');
+    inRange(affection, 0, 100, 'affection');
+    inRange(homeLevel, 0, 2, 'homeLevel');
+    for (final entry in jobPractice.entries) {
+      checkJob(entry.key);
+      inRange(entry.value, 0, maxCounter, 'jobPractice');
+    }
+    for (final skill in learnedSkills) {
+      checkJob(skill);
+    }
+    if (learnedSkills.toSet().length != learnedSkills.length) {
+      throw const FormatException('人生技能不可重複');
+    }
+    if (inheritedSkill != null) {
+      checkJob(inheritedSkill!);
+      if (!learnedSkills.contains(inheritedSkill)) {
+        throw const FormatException('傳承技能必須列入已習得技能');
+      }
+    }
+  }
+
+  Map<String, dynamic> toJson() {
+    _validate();
+    return {
+      'turns': turns,
+      'generation': generation,
+      'eq': eq,
+      'stress': stress,
+      'affection': affection,
+      'homeLevel': homeLevel,
+      'jobPractice': jobPractice,
+      'learnedSkills': learnedSkills,
+      'inheritedSkill': inheritedSkill,
+    };
+  }
+
+  factory LifeProgress.fromJson(
+    Map<String, dynamic> json,
+    Set<String> validJobIds,
+  ) {
+    checkKeys(json, {
+      'turns',
+      'generation',
+      'eq',
+      'stress',
+      'affection',
+      'homeLevel',
+      'jobPractice',
+      'learnedSkills',
+      'inheritedSkill',
+    }, 'life');
+    final practice = jsonObject(json['jobPractice'], 'life.jobPractice');
+    final life = LifeProgress._(
+      turns: jsonInt(json['turns'], 'life.turns'),
+      generation: jsonInt(json['generation'], 'life.generation'),
+      eq: jsonInt(json['eq'], 'life.eq'),
+      stress: jsonInt(json['stress'], 'life.stress'),
+      affection: jsonInt(json['affection'], 'life.affection'),
+      homeLevel: jsonInt(json['homeLevel'], 'life.homeLevel'),
+      jobPractice: Map<String, int>.unmodifiable({
+        for (final entry in practice.entries)
+          entry.key: jsonInt(entry.value, 'life.jobPractice.${entry.key}'),
+      }),
+      learnedSkills: List<String>.unmodifiable(
+        jsonList(
+          json['learnedSkills'],
+          'life.learnedSkills',
+        ).map((value) => jsonText(value, 'life.learnedSkills')),
+      ),
+      inheritedSkill: json['inheritedSkill'] == null
+          ? null
+          : jsonText(json['inheritedSkill'], 'life.inheritedSkill'),
+    );
+    life._validate(validJobIds: validJobIds);
+    return life;
+  }
+}
diff --git a/lib/domain/models/life_story.dart b/lib/domain/models/life_story.dart
new file mode 100644
index 0000000..d17c33a
--- /dev/null
+++ b/lib/domain/models/life_story.dart
@@ -0,0 +1,290 @@
+import 'json_checks.dart';
+import 'life_progress.dart';
+
+/// A frozen ending, recorded once for a generation even if play continues.
+class EndingRecord {
+  final int generation, age, money, learnedCount;
+  final String id, jobId;
+
+  const EndingRecord({
+    required this.generation,
+    required this.age,
+    required this.id,
+    required this.jobId,
+    required this.money,
+    required this.learnedCount,
+  });
+
+  void validate({Set<String>? validJobIds}) {
+    if (generation < 1 ||
+        generation > LifeProgress.maxCounter ||
+        age < 18 ||
+        age > 18 + LifeProgress.maxCounter ~/ 4 ||
+        money < 0 ||
+        learnedCount < 0 ||
+        learnedCount > 1000 ||
+        !LifeStory.endingIds.contains(id) ||
+        jobId.trim().isEmpty ||
+        (validJobIds != null && !validJobIds.contains(jobId))) {
+      throw const FormatException('人生結局紀錄無效');
+    }
+  }
+
+  Map<String, dynamic> toJson() {
+    validate();
+    return {
+      'generation': generation,
+      'age': age,
+      'id': id,
+      'jobId': jobId,
+      'money': money,
+      'learnedCount': learnedCount,
+    };
+  }
+
+  factory EndingRecord.fromJson(
+    Map<String, dynamic> json,
+    Set<String> validJobIds,
+  ) {
+    checkKeys(json, {
+      'generation',
+      'age',
+      'id',
+      'jobId',
+      'money',
+      'learnedCount',
+    }, 'ending');
+    final record = EndingRecord(
+      generation: jsonInt(json['generation'], 'ending.generation'),
+      age: jsonInt(json['age'], 'ending.age'),
+      id: jsonText(json['id'], 'ending.id'),
+      jobId: jsonText(json['jobId'], 'ending.jobId'),
+      money: jsonInt(json['money'], 'ending.money'),
+      learnedCount: jsonInt(json['learnedCount'], 'ending.learnedCount'),
+    );
+    record.validate(validJobIds: validJobIds);
+    return record;
+  }
+}
+
+/// Original, immutable story/family progress. Collection inputs are copied.
+/// A fresh const instance starts with all three adult acquaintances unmet.
+class LifeStory {
+  static const npcIds = {'cen_yu', 'chu_ye', 'luo_qing'};
+  static const chainIds = {'lantern', 'craft', 'roots'};
+  static const endingIds = {
+    'trials',
+    'scholar',
+    'family',
+    'prosperity',
+    'peaceful',
+  };
+  static const historyLimit = 30;
+
+  final Map<String, int> affinities;
+  final String? partnerId;
+  final bool married;
+  final int children;
+  final Map<String, int> storySteps;
+  final Map<String, String> storyChoices;
+  final int lastSettledTurn;
+  final List<EndingRecord> history;
+  final String? currentEndingId;
+
+  const LifeStory({this.lastSettledTurn = 0})
+    : affinities = const {'cen_yu': 0, 'chu_ye': 0, 'luo_qing': 0},
+      partnerId = null,
+      married = false,
+      children = 0,
+      storySteps = const {'lantern': 0, 'craft': 0, 'roots': 0},
+      storyChoices = const {},
+      history = const [],
+      currentEndingId = null,
+      assert(
+        lastSettledTurn >= 0 && lastSettledTurn <= LifeProgress.maxCounter,
+      );
+
+  const LifeStory._({
+    required this.affinities,
+    required this.partnerId,
+    required this.married,
+    required this.children,
+    required this.storySteps,
+    required this.storyChoices,
+    required this.lastSettledTurn,
+    required this.history,
+    required this.currentEndingId,
+  });
+
+  LifeStory copyWith({
+    Map<String, int>? affinities,
+    String? partnerId,
+    bool clearPartner = false,
+    bool? married,
+    int? children,
+    Map<String, int>? storySteps,
+    Map<String, String>? storyChoices,
+    int? lastSettledTurn,
+    List<EndingRecord>? history,
+    String? currentEndingId,
+    bool clearCurrentEnding = false,
+  }) {
+    final next = LifeStory._(
+      affinities: affinities == null
+          ? this.affinities
+          : Map<String, int>.unmodifiable(affinities),
+      partnerId: clearPartner ? null : partnerId ?? this.partnerId,
+      married: married ?? this.married,
+      children: children ?? this.children,
+      storySteps: storySteps == null
+          ? this.storySteps
+          : Map<String, int>.unmodifiable(storySteps),
+      storyChoices: storyChoices == null
+          ? this.storyChoices
+          : Map<String, String>.unmodifiable(storyChoices),
+      lastSettledTurn: lastSettledTurn ?? this.lastSettledTurn,
+      history: history == null
+          ? this.history
+          : List<EndingRecord>.unmodifiable(history),
+      currentEndingId: clearCurrentEnding
+          ? null
+          : currentEndingId ?? this.currentEndingId,
+    );
+    next.validate();
+    return next;
+  }
+
+  /// With life provided, also reject impossible save cross-references.
+  void validate({LifeProgress? life, Set<String>? validJobIds}) {
+    if (affinities.keys.toSet().difference(npcIds).isNotEmpty ||
+        npcIds.difference(affinities.keys.toSet()).isNotEmpty ||
+        affinities.values.any((v) => v < 0 || v > 100) ||
+        storySteps.keys.toSet().difference(chainIds).isNotEmpty ||
+        chainIds.difference(storySteps.keys.toSet()).isNotEmpty ||
+        storySteps.values.any((v) => v < 0 || v > 3) ||
+        (partnerId != null && !npcIds.contains(partnerId)) ||
+        (married && partnerId == null) ||
+        children < 0 ||
+        children > 2 ||
+        (children > 0 && !married) ||
+        lastSettledTurn < 0 ||
+        lastSettledTurn > LifeProgress.maxCounter ||
+        history.length > historyLimit ||
+        (currentEndingId != null && !endingIds.contains(currentEndingId))) {
+      throw const FormatException('人生故事或家庭資料無效');
+    }
+    for (final entry in storyChoices.entries) {
+      final parts = entry.key.split('_');
+      final step = parts.length == 2 ? int.tryParse(parts.last) : null;
+      if (parts.length != 2 ||
+          !chainIds.contains(parts.first) ||
+          step == null ||
+          step < 0 ||
+          step > 2 ||
+          entry.key != '${parts.first}_$step' ||
+          step >= storySteps[parts.first]! ||
+          !{'a', 'b'}.contains(entry.value)) {
+        throw const FormatException('故事選擇必須對應已完成章節的有效選項');
+      }
+    }
+    var previousGeneration = 0;
+    for (final record in history) {
+      record.validate(validJobIds: validJobIds);
+      if (record.generation <= previousGeneration) {
+        throw const FormatException('結局世代不可重複或倒序');
+      }
+      previousGeneration = record.generation;
+    }
+    if (currentEndingId != null &&
+        (history.isEmpty || history.last.id != currentEndingId)) {
+      throw const FormatException('目前結局必須對應最新紀錄');
+    }
+    if (life != null) {
+      if (lastSettledTurn > life.turns ||
+          history.any((record) => record.generation > life.generation) ||
+          (currentEndingId != null &&
+              history.last.generation != life.generation) ||
+          (currentEndingId == null &&
+              history.any((r) => r.generation == life.generation)) ||
+          (currentEndingId != null && history.last.age > life.age)) {
+        throw const FormatException('人生故事與世代／回合不符');
+      }
+    }
+  }
+
+  Map<String, dynamic> toJson() {
+    validate();
+    return {
+      'affinities': affinities,
+      'partnerId': partnerId,
+      'married': married,
+      'children': children,
+      'storySteps': storySteps,
+      'storyChoices': storyChoices,
+      'lastSettledTurn': lastSettledTurn,
+      'history': history.map((r) => r.toJson()).toList(growable: false),
+      'currentEndingId': currentEndingId,
+    };
+  }
+
+  factory LifeStory.fromJson(
+    Map<String, dynamic> json,
+    Set<String> validJobIds, {
+    required LifeProgress life,
+  }) {
+    checkKeys(json, {
+      'affinities',
+      'partnerId',
+      'married',
+      'children',
+      'storySteps',
+      'storyChoices',
+      'lastSettledTurn',
+      'history',
+      'currentEndingId',
+    }, 'story');
+    Map<String, int> counters(String key) {
+      final values = jsonObject(json[key], 'story.$key');
+      return Map<String, int>.unmodifiable({
+        for (final e in values.entries)
+          e.key: jsonInt(e.value, 'story.$key.${e.key}'),
+      });
+    }
+
+    if (json['married'] is! bool)
+      throw const FormatException('story.married 必須是布林值');
+    final story = LifeStory._(
+      affinities: counters('affinities'),
+      partnerId: json['partnerId'] == null
+          ? null
+          : jsonText(json['partnerId'], 'story.partnerId'),
+      married: json['married'] as bool,
+      children: jsonInt(json['children'], 'story.children'),
+      storySteps: counters('storySteps'),
+      storyChoices: Map<String, String>.unmodifiable({
+        for (final entry in jsonObject(
+          json['storyChoices'],
+          'story.storyChoices',
+        ).entries)
+          entry.key: jsonText(entry.value, 'story.storyChoices.${entry.key}'),
+      }),
+      lastSettledTurn: jsonInt(
+        json['lastSettledTurn'],
+        'story.lastSettledTurn',
+      ),
+      history: List<EndingRecord>.unmodifiable(
+        jsonList(json['history'], 'story.history').map(
+          (r) => EndingRecord.fromJson(
+            jsonObject(r, 'story.history.record'),
+            validJobIds,
+          ),
+        ),
+      ),
+      currentEndingId: json['currentEndingId'] == null
+          ? null
+          : jsonText(json['currentEndingId'], 'story.currentEndingId'),
+    );
+    story.validate(life: life, validJobIds: validJobIds);
+    return story;
+  }
+}
