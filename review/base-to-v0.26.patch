+  void changeZoom(double amount) =>
+      zoom = (zoom + amount).clamp(.75, 1.35).toDouble();
+  void resetCamera() {
+    yaw = .72;
+    zoom = 1;
+  }
+
+  static final List<Vector2> centers = boardCenters
+      .map((p) => Vector2(p.x, p.y))
+      .toList();
+  Vector2 pawnCenter(int index) => centers[index] + Vector2(0, -1);
+  static V3 worldFromPoint(double x, double y) {
+    final a = (x - 450) / 72, b = (y - 85) / 36;
+    return V3((a + b) / 2 - 2.5, 0, (b - a) / 2 - 2.5);
+  }
+
+  @override
+  Color backgroundColor() => const Color(0x00000000);
+  @override
+  Future<void> onLoad() async {
+    await super.onLoad();
+    pawn = PlayerComponent(pawnCenter(initialPosition))
+      ..equipment = _equipment
+      ..jobId = _equipment.jobId;
+    await add(
+      pawn,
+    ); // movement controller remains; rendering uses XYZ meshes below.
+    isBoardReady = true;
+    onBoardReady?.call();
+  }
+
+  @override
+  void update(double dt) {
+    super.update(dt);
+    _clock += dt;
+    if (!isBoardReady) return;
+    final p = worldFromPoint(pawn.position.x, pawn.position.y + 1);
+    if (_last != null) {
+      final d = p - _last!;
+      if (d.x.abs() + d.z.abs() > .001) _heading = math.atan2(d.x, d.z);
+    }
+    _last = p;
+  }
+
+  Scene3D _environment() {
+    final board = ageBoard, visualStage = board.visualStage;
+    if (_terrain != null && _terrainBoardId == board.id) return _terrain!;
+    final scene = Scene3D();
+    _base = Scene3D();
+    ChapterBoard.floor(_base!, visualStage);
+    ChapterBoard.scenery(scene, visualStage);
+    for (final tile in board.tiles) {
+      final point = centers[tile.index], p = worldFromPoint(point.x, point.y);
+      ChapterBoard.tile(scene, p, tile.kind, visualStage);
+      if (tile.kind == TileKind.shop) ChapterBoard.shop(scene, p, visualStage);
+    }
+    _terrainBoardId = board.id;
+    return _terrain = scene;
+  }
+
+  @override
+  void render(Canvas canvas) {
+    if (!isBoardReady) return;
+    final viewport = this.size;
+    if (viewport.x <= 0 || viewport.y <= 0) return;
+    final scale = math.min(viewport.x / 900, viewport.y / 560);
+    canvas.save();
+    canvas.clipRect(Rect.fromLTWH(0, 0, viewport.x, viewport.y));
+    canvas.scale(scale);
+    final size = Size(viewport.x / scale, viewport.y / scale),
+        scene = Scene3D(),
+        actor = Scene3D();
+    final board = ageBoard;
+    final camera = Camera3D(
+      eye: V3(math.sin(yaw) * 10 / zoom, 8 / zoom, math.cos(yaw) * 10 / zoom),
+      target: const V3(0, .2, 0),
+      focal: 1.22,
+    );
+    scene.faces.addAll(_environment().faces);
+    canvas.drawOval(
