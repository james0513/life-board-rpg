+  final runs = <Map<String, Object>>[];
+  for (final seed in [1, 7, 19, 42, 99, 123, 2026, 31415, 65535, 99991]) {
+    final result = await Campaign(seed).run();
+    runs.add(result);
+    print('PASS seed $seed: ${result['fights']} wins, ${result['turns']} turns, '
+      'age ${result['ageAtCompletion']}, ${result['checkpoints']} verified save boundaries, '
+      'generation 2 mentor bonus INT ${result['generationTwoIntelligence']}');
+  }
+  final report = {'mode': 'Pure Dart scripted domain campaign; no Flutter widget/dice-board test',
+    'assertions': assertions, 'passedCampaigns': runs.length,
+    'totalVictories': runs.fold<int>(0, (sum, r) => sum + (r['fights'] as int)),
+    'totalCheckpoints': runs.fold<int>(0, (sum, r) => sum + (r['checkpoints'] as int)),
+    'hpFormulaChecks': 6, 'runs': runs};
+  File('docs/life_campaign_report.json').writeAsStringSync(const JsonEncoder.withIndent('  ').convert(report));
+  print('PASS $assertions assertions; report docs/life_campaign_report.json');
+}
