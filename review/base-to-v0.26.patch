+void checkHpFormula() {
+  const enemy = Enemy(id: 'hp_probe', name: 'HP probe', description: '', hp: 1,
+    attack: 1, reward: 0, portrait: 0);
+  check(BattleSession(const Player(), enemy).maxHp == 80,
+    'Default player HP changed from original baseline 80');
+  check(BattleSession(const Player(life: LifeProgress(eq: 90, stress: 20, homeLevel: 2)), enemy).maxHp == 88,
+    'Combined EQ/stress/home HP should be 88');
+  check(BattleSession(const Player(life: LifeProgress(eq: 0, stress: 100)), enemy).maxHp == 65,
+    'Worst valid EQ/stress HP should be 65');
+  check(BattleSession(const Player(stamina: 0, life: LifeProgress(eq: 0, stress: 100)), enemy).maxHp == 45,
+    'Zero stamina with worst valid meters should still be survivable');
+  check(BattleSession(const Player(life: LifeProgress(homeLevel: 1)), enemy).maxHp == 83,
+    'Each home level must add 3 HP');
+  check(BattleSession(const Player(life: LifeProgress(eq: 41, stress: 9)), enemy).maxHp == 80,
+    'Meter rounding must truncate toward zero');
+}
