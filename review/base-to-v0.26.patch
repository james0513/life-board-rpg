+  EquipmentLook _equipment;
+  int stage;
+  int age;
+  AgeBoard get ageBoard => AgeBoard.forAge(age);
+  final int initialPosition;
+  final void Function()? onBoardReady;
+  late final PlayerComponent pawn;
+  bool isBoardReady = false;
+  double yaw = .72, zoom = 1, _clock = 0, _heading = 0;
+  V3? _last;
+  Scene3D? _terrain;
+  Scene3D? _base;
+  String? _terrainBoardId;
+  void changeEquipment(EquipmentLook value) {
+    _equipment = value;
+    if (isBoardReady) {
+      pawn.equipment = value;
+      pawn.jobId = value.jobId;
+    }
+  }
+
+  void changeStage(int value) => stage = value;
+  void changeAge(int value) {
+    final previous = ageBoard;
+    age = value;
+    if (previous.id != ageBoard.id) {
+      _terrain = null;
+      _base = null;
+      _terrainBoardId = null;
+    }
+  }
+
+  void changeCareer(String id, {CharacterGender? gender}) => changeEquipment(
+    _equipment.withCharacter(id, gender ?? _equipment.gender),
+  );
