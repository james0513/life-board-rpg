+            return _service.lifeAction(const Player(), action);
+          },
+        ),
+      );
+      await _show(tester, 'life-action-study');
+      final study = find.byKey(const ValueKey('life-action-study'));
+      await tester.tap(study);
+      await tester.pumpAndSettle();
